  "homepage": "https://github.com/addxing/dsh-reply-notification#readme",
  "bugs": { "url": "https://github.com/addxing/dsh-reply-notification/issues" },
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "cordis", "notification", "macos"],
  "os": ["darwin"],
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "exports": { ".": "./index.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "notification.js", "prepare-notifier.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "THIRD-PARTY-NOTICES.md", "native/Notifier.app/Contents/Info.plist", "native/Notifier.app/Contents/MacOS/terminal-notifier", "native/README.markdown"],
